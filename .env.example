# ==============================================================================
# 🏮 VIDYAPATH ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your service credentials.
# Never commit real secrets or production .env files to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# ------------------------------------------------------------------------------
# 2. NEON SERVERLESS POSTGRESQL (20-TABLE RELATIONAL DATA LAYER)
# If omitted or offline, Vidyapath automatically falls back to its in-memory
# resilient Reactive Store without crashing.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. GROQ CLOUD AI & STT INFERENCE ENGINE
# Free Tier: 1,000 req/day, 14,400 tokens/min quota (~300 tokens/sec)
# Default Models:
#   Primary: openai/gpt-oss-120b or llama-3.3-70b-versatile
#   Fallback Chain: qwen/qwen3.8-27b -> openai/gpt-oss-20b
#   Voice STT: whisper-large-v3-turbo / whisper-large-v3
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. ELEVENLABS NEURAL TEXT-TO-SPEECH (TTS)
# Free Tier: 10,000 chars/month.
# Smart Voice Router routes key takeaways (<120 chars) to ElevenLabs and full
# chapter lectures to client-side Web Speech API to preserve quota.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 IN-MEMORY OBJECT STORAGE (S3 COMPATIBLE)
# Eliminates ephemeral filesystem data loss on Render.
# Free Tier: 10 GB storage free/month, $0 Egress Bandwidth Fees.
# If omitted, system falls back to in-memory Base64 streaming in local dev.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vidyapath-assets
R2_PUBLIC_DOMAIN=https://pub-yourr2id.r2.dev

# ------------------------------------------------------------------------------
# 6. EMAILJS TRANSACTIONAL VERIFICATION SERVICE
# Free Tier: 200 emails/month.
# Used for 6-digit OTP verification and institution onboarding credentials.
# If omitted, system runs zero-crash mock simulation returning devOtp in payload.
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=service_sample
EMAILJS_TEMPLATE_ID=template_sample
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (VITE)
# When deploying frontend on Netlify Edge CDN and backend on Render:
# Leave VITE_API_BASE_URL empty if using Netlify Edge proxy rules (/api/* -> Render)
# Or set to full backend URL: https://vidyapath.onrender.com
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 8. GITHUB ACTIONS APK RELEASE INTEGRATION (OPTIONAL)
# Used by backend to query latest Android APK builds from GitHub Releases.
# ------------------------------------------------------------------------------
GITHUB_REPO_OWNER=yynvr1408
GITHUB_REPO_NAME=vidhyapath
GITHUB_RELEASE_REPO=yynvr1408/vidhyapath
GITHUB_PAT_TOKEN=
