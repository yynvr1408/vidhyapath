# Copy this file to .env and fill in real values. Never commit .env or put a real key in this file.
# Without external keys set, Vidyapath runs 100% offline with zero data cost.

# --- 1. Generic AI Tutor (OpenAI-compatible fallback) ---
TUTOR_API_BASE_URL=https://api.groq.com/openai/v1
TUTOR_MODEL=llama-3.3-70b-versatile
TUTOR_API_KEY=

# --- 2. Groq API (Ultra-fast LLM & Whisper STT) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- 3. ElevenLabs API (Natural Multilingual Voice Synthesis) ---
# https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- 4. Neon Database (Serverless Postgres) ---
# https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- 5. Cloudflare R2 Bucket (Zero-Egress Object Storage) ---
# https://dash.cloudflare.com/ -> R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vidyapath-assets
R2_PUBLIC_DOMAIN=https://assets.vidyapath.org

# --- 6. In-App Auto-Updates (GitHub Releases) ---
# Supports either GITHUB_RELEASE_REPO="owner/repo" or GITHUB_REPO_OWNER + GITHUB_REPO_NAME
GITHUB_RELEASE_REPO=yynvr1408/vidhyapath
GITHUB_REPO_OWNER=yynvr1408
GITHUB_REPO_NAME=vidhyapath
GITHUB_PAT_TOKEN= # Optional if repo is public; required if private (GitHub Personal Access Token with 'repo' scope)

# --- 7. Native Mobile Builds (Capacitor) ---
# Public server URL used by the native Android APK and iOS builds.
# Empty or unset means same-origin (web/PWA deployment).
VITE_API_BASE_URL=https://your-server.example.com
