# Copy this file to .env and fill in real values. Never commit .env or put a real key in this file.
# Without all three variables set, the AI tutor uses offline answers.

# Base URL of any OpenAI-compatible provider (the server appends /chat/completions).
TUTOR_API_BASE_URL=https://api.example.com/v1

# Model name the provider expects.
TUTOR_MODEL=your-model-name

# API key for the provider. Server-side only; never sent to the browser or logged.
TUTOR_API_KEY=your-api-key-here
