# Copy this file to .env for local backend development.
# Never put real credentials in source control.

NODE_ENV=development
PORT=3001
# Development can use a process-random signing key. Production must use 32+ random characters.
JWT_SECRET=

# Durable storage is required for production.
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000

# The production administrator is created from these operator-provided values.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=

# Optional server integrations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# EmailJS transactional mail settings. Required in production for OTP and invitations.
EMAILJS_SERVICE_ID=
EMAILJS_SERVICE_ID_VERIFICATION=
EMAILJS_TEMPLATE_ID=
EMAILJS_TEMPLATE_VERIFICATION=
EMAILJS_TEMPLATE_PASSWORD_RESET=
EMAILJS_TEMPLATE_NOTIFICATION=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_PUBLIC_KEY_VERIFICATION=
EMAILJS_PRIVATE_KEY_VERIFICATION=

# Optional frontend setting. Leave empty when Netlify proxies /api to Render.
VITE_API_BASE_URL=
